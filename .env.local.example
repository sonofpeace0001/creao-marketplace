NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — payments won't work without these. Get them from
# https://dashboard.stripe.com/apikeys (secret key) and
# https://dashboard.stripe.com/webhooks (webhook signing secret, after
# adding an endpoint pointed at https://<your-domain>/api/webhooks/stripe
# listening for the checkout.session.completed event).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
